# License server settings. Copy to .env and fill in:
#
#   cp .env.example .env
#
# Read by `docker compose up` (license-server/compose.yml) and by `npm start`.
# Never commit .env.

# --- Required --------------------------------------------------------------

# Signs download links. 32+ characters; generate with: openssl rand -hex 32
# Changing it only invalidates download links already handed out.
SIGNING_SECRET=

# Bearer token for the /admin API. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# Public base URL WordPress sites use to reach this server (no trailing slash).
# Download links are built from it. Must match the plugin's Update URI header.
PUBLIC_URL=https://licenses.example.com

# --- Releases ----------------------------------------------------------------

# Where new plugin versions come from:
#   - folder: RELEASES_DIR=/releases serves release.json + zip from ./releases
#     (compose mounts it; build with bin/build-zip.sh license-server/releases)
#   - GitHub Releases: leave RELEASES_DIR empty
RELEASES_DIR=

# Repository whose latest release is served (GitHub source).
GITHUB_REPO=fanismahmalat/wp-plugin-product-sync-feeds

# Only needed for a private repository or higher API rate limits
# (fine-grained token with read access to Contents).
GITHUB_TOKEN=

# Asset / file name of the plugin zip.
ZIP_ASSET=product-sync-feeds.zip

# Seconds the latest release is cached before asking the source again.
RELEASE_CACHE_SECONDS=300

# --- Server ------------------------------------------------------------------

# Port inside the container (compose publishes it as 8090 on the host).
PORT=8080

# SQLite database and GitHub zip cache. The Docker image uses /data (a volume).
DATA_DIR=./data

# Download link lifetime in seconds.
DOWNLOAD_TTL_SECONDS=3600

# Requests per minute per IP on the public /v1 endpoints.
RATE_LIMIT_PER_MINUTE=120

# Set to 1 behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=0

# Shown as the plugin homepage in the WordPress "View details" popup.
PLUGIN_HOMEPAGE=https://github.com/fanismahmalat/wp-plugin-product-sync-feeds
