# Left out of GitHub's automatic "Source code" archives: only the plugin and
# its license ship there. Releases attach the built zip (bin/build-zip.sh).
/.github export-ignore
/bin export-ignore
/docker export-ignore
/docker-compose.yml export-ignore
/license-server export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
